# Development/self-host example. Set your own credentials and URLs.
YOURHAND_BASE_URL=http://127.0.0.1:8790
YOURHAND_WEB_PORT=8790
YOURHAND_AGENT_PORT=8791
YOURHAND_MCP_PORT=8792
YOURHAND_DB_FILE=./runtime/yourhand-community.db
